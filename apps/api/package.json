{
  "name": "@seat-snaps/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace=@seat-snaps/shared --workspace=@seat-snaps/db",
    "dev": "nest start --watch",
    "prebuild": "npm run build --workspace=@seat-snaps/shared --workspace=@seat-snaps/db",
    "build": "nest build",
    "prestart": "npm run build --workspace=@seat-snaps/shared --workspace=@seat-snaps/db",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.23",
    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.23",
    "@seat-snaps/db": "*",
    "@seat-snaps/shared": "*",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@swc/core": "^1.15.33",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.2",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
