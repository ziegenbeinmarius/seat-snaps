# Api
API_PORT=3001
APP_URL="http://localhost:3005"

# Payments — controls the checkout flow
# dummy    = fake flow (rate-limited; works for dev/demo, credits are granted immediately)
# disabled = endpoint returns 503 (use in prod until a real provider is configured)
# stripe   = Stripe Checkout (not yet implemented)
PAYMENTS_MODE=dummy

# CORS — comma-separated list of allowed origins (required in production)
# ALLOWED_ORIGINS="https://your-domain.com"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/railway"

# Auth
AUTH_SECRET="your-auth-secret-here-min-32-chars"
NEXTAUTH_SECRET="your-auth-secret-here-min-32-chars"

# Public web URL (important for Auth.js in production)
# AUTH_URL="https://seat-snaps.up.railway.app"
# Trust reverse-proxy host headers (Railway/other platforms)
# AUTH_TRUST_HOST="true"

# Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:admin@your-domain.com"
# NEXT_PUBLIC_VAPID_KEY is not needed — the key is fetched from /api/push-subscriptions/vapid-key

# Object Storage (S3-compatible: Railway Buckets, AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_BUCKET_NAME="seat-snaps-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://s3.amazonaws.com"  # Set to your provider's endpoint (e.g. Railway Buckets, R2, MinIO)

# App
#AUTH_SECRET="your-auth-secret-here-min-32-chars"
#NEXTAUTH_SECRET="your-auth-secret-here-min-32-chars"
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://localhost:3001"
# Public-facing app URL used for QR codes and attendee join links (set to production URL in Railway)
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

