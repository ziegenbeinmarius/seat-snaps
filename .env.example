# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/seat_snaps"

# Auth
AUTH_SECRET="your-auth-secret-here-min-32-chars"

# AWS S3 / Object Storage
S3_BUCKET_NAME="seat-snaps-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_ENDPOINT="https://s3.amazonaws.com"  # Override for S3-compatible services (e.g. MinIO, R2)

# App
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001
