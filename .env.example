# Api
API_PORT=3001
APP_URL="http://localhost:3005"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/railway"

# Auth
AUTH_SECRET="your-auth-secret-here-min-32-chars"
NEXTAUTH_SECRET="your-auth-secret-here-min-32-chars"

# Public web URL (important for Auth.js in production)
# AUTH_URL="https://seat-snaps.up.railway.app"
# Trust reverse-proxy host headers (Railway/other platforms)
# AUTH_TRUST_HOST="true"

# Object Storage (S3-compatible: Railway Buckets, AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_BUCKET_NAME="seat-snaps-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://s3.amazonaws.com"  # Set to your provider's endpoint (e.g. Railway Buckets, R2, MinIO)

# App
#AUTH_SECRET="your-auth-secret-here-min-32-chars"
#NEXTAUTH_SECRET="your-auth-secret-here-min-32-chars"
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://localhost:3001"

