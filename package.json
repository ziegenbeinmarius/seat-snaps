{
  "name": "seat-snaps",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace=${RAILWAY_WORKSPACE:-@seat-snaps/api}",
    "start:api": "npm run start --workspace=@seat-snaps/api",
    "start:web": "npm run start --workspace=@seat-snaps/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npm run db:generate --workspace=@seat-snaps/db",
    "db:migrate": "npm run db:migrate --workspace=@seat-snaps/db",
    "db:push": "npm run db:push --workspace=@seat-snaps/db",
    "db:studio": "npm run db:studio --workspace=@seat-snaps/db",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
